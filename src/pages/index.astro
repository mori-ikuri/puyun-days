---
// リンク集（URLは仮置き。あとで自分のページのURLに差し替える）
const links = [
  { name: 'X', url: 'https://x.com/' },
  { name: 'Threads', url: 'https://www.threads.com/' },
  { name: 'note', url: 'https://note.com/' },
  { name: 'DEV', url: 'https://dev.to/' },
  { name: 'GitHub', url: 'https://github.com/' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>puyun-days</title>
    <meta name="description" content="ぷゆん（Puyun）の個人サイト" />
  </head>
  <body>
    <main>
      <h1>puyun-days</h1>

      <section>
        <h2>ぷゆんについて</h2>
        <p>
          こんにちは、ぷゆん（Puyun）です。<br />
          日々つくったもの・書いたものを、ここに少しずつまとめていきます。
        </p>
      </section>

      <section>
        <h2>リンク</h2>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.url} rel="noopener noreferrer">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.7;
    color: #222;
    background: #fff;
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  a {
    color: #0b62c4;
  }
</style>
