---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { articles, withBase } from '../lib/articles';

// リンク集（ぷゆんの各サービスのプロフィールページ）
const links = [
  { name: 'X', url: 'https://x.com/puyun_days' },
  { name: 'Threads', url: 'https://www.threads.com/@puyun_days' },
  { name: 'note', url: 'https://note.com/puyun_days' },
  { name: 'DEV', url: 'https://dev.to/puyun_days' },
  { name: 'GitHub', url: 'https://github.com/mori-ikuri' },
];

const latest = articles.slice(0, 3);
---

<BaseLayout title="puyun-days" description="ぷゆん（Puyun）の個人サイト">
  <h1>puyun-days</h1>

  <section>
    <h2>ぷゆんについて</h2>
    <p>
      こんにちは、ぷゆん（Puyun）です。<br />
      日々つくったもの・書いたものを、ここに少しずつまとめていきます。
    </p>
  </section>

  <section>
    <h2>最新の記事</h2>
    {latest.length > 0 ? <ArticleList items={latest} /> : <p>まだ記事がありません。</p>}
    <p><a href={withBase('articles/')}>記事一覧へ →</a></p>
  </section>

  <section>
    <h2>活動</h2>
    <p><a href={withBase('activities/')}>活動ダッシュボードへ →</a></p>
  </section>

  <section>
    <h2>リンク</h2>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.url} rel="noopener noreferrer">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
